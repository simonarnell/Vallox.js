{
  "$id": "vallox:device-time-components",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device time components",
  "description": "Raw clock components as read from the unit, before being assembled into a Date.",
  "type": "object",
  "properties": {
    "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
    "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
    "day": { "type": "integer", "minimum": 1, "maximum": 31 },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "year": { "type": "integer", "minimum": 0, "maximum": 99 }
  },
  "required": ["minute", "hour", "day", "month", "year"],
  "additionalProperties": false
}
